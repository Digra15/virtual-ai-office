# Copy to .env and fill in. Placeholders only — no real secrets here.

# --- Backend (apps/server) ---
PORT=4000
# Comma-separated origins allowed to call the REST API / open the WS
CORS_ORIGIN=http://localhost:5173
# Generate clearly-labeled demo agent activity when no real agents are connected
DEMO_MODE=true
# Mark live agents offline if no heartbeat/event seen within this many ms
OFFLINE_TIMEOUT_MS=30000
# Max POST /api/agents/:id/events requests per IP per minute
RATE_LIMIT_PER_MINUTE=60

# --- Frontend (apps/web) ---
# Base URL of the backend REST API (no trailing slash)
VITE_API_URL=http://localhost:4000
# WebSocket URL of the backend (must end in /ws)
VITE_WS_URL=ws://localhost:4000/ws
