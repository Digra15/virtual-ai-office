{
  "description": "Virtual AI Office \u2014 a 3D mission-control dashboard for monitoring AI agents",
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=20"
  },
  "name": "virtual-ai-office",
  "private": true,
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:server": "npm run build --workspace @virtual-ai-office/server",
    "build:shared": "npm run build --workspace @virtual-ai-office/shared",
    "build:web": "npm run build --workspace @virtual-ai-office/web",
    "dev:server": "npm run dev --workspace @virtual-ai-office/server",
    "dev:web": "npm run dev --workspace @virtual-ai-office/web",
    "dev:worker": "npm run dev --workspace @virtual-ai-office/worker",
    "lint": "eslint .",
    "postinstall": "npm run build --workspace @virtual-ai-office/shared",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
